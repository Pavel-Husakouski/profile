# Имена, из которых собираются имена файлов выхлопа (PDF/DOCX).
EN_NAME="Pavel Husakouski"
RU_NAME="Павел Гусаковский"
ROLE="Nodejs-backend-fullstack"

# Контакты. PHONE, LOCATION и FORMAT подклеивает генератор — в cv-*.md стоят
# плейсхолдеры. EMAIL, LINKEDIN и TELEGRAM в cv-*.md написаны открытым текстом,
# и отсюда их читает только блок «Контакты» каталога: правя один, правь и другой.
# Без префикса — одно значение на оба языка, с EN_/RU_ — своё на каждый.
EMAIL="you@example.com"
PHONE="+000(00)000-00-00"
LINKEDIN="https://www.linkedin.com/in/your-handle/"
TELEGRAM="@your_handle"
EN_LOCATION="City, Country"
RU_LOCATION="Город, Страна"
EN_FORMAT="Office or remote"
RU_FORMAT="Офис или удалённо"

# Папка на rclone-ремоуте, куда уезжают PDF.
DRIVE_DIR="MyDrive:@cv"
